function Invoke-LLMProvider {
    param (
        [Parameter(Mandatory=$true)][string]$Prompt,
        [string]$Provider = "KodeKloud",
        [string]$EndpointUrl = "https://your-kodekloud-llm-url.com/v1/chat/completions",
        [string]$Model = "qwen3:8b",
        [string]$ApiKey = "YOUR_KODEKLOUD_PASSWORD_OR_TOKEN"
    )

    if ($Provider -eq "KodeKloud") {
        $body = @{
            model = $Model
            messages = @(
                @{
                    role = "user"
                    content = $Prompt
                }
            )
            temperature = 0.1
        } | ConvertTo-Json -Depth 5

        $headers = @{
            "Authorization" = "Bearer $ApiKey"
            "Content-Type"  = "application/json"
        }

        try {
            $response = Invoke-RestMethod -Uri $EndpointUrl -Method Post -Headers $headers -Body $body -TimeoutSec 15
            if ($response.choices) {
                return $response.choices[0].message.content
            }
            return $response.response
        }
        catch {
            # Offline or Error Fallback Logic
            return $null
        }
    }
    else {
        throw "Provider '$Provider' is not supported."
    }
}